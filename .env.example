# 複製為 .env 後修改（docker compose 會自動讀取）

# ── 網站 ──
# 對外埠號（NAS 上的埠，容器內固定 9122）
CLURE_PORT=9122
TZ=Asia/Taipei

# ── 資料與權限（docker-compose.yml 熱更新版）──
# 資料庫等持久化資料放在哪裡（相對於專案資料夾，或填 NAS 上的絕對路徑，例如 /volume1/docker/clure-data）
#   ⚠ 覆蓋更新檔案時請保留這個資料夾；放在專案資料夾以外最安全
CLURE_DATA_PATH=./data
# 後端以哪個使用者身分寫入資料夾（Synology 一般為 1026／100；在 NAS 終端機執行 id 可查詢）
PUID=1026
PGID=100
# 前端建置器：檢查檔案變更的間隔、最後一次變更後等多久才建置（毫秒）、建置前是否先跑單元測試
CLURE_POLL_MS=2000
CLURE_SETTLE_MS=4000
CLURE_RUN_TESTS=false

# ── 後端帳號系統 ──
# JWT 簽章金鑰（建議設定一組 64 字元以上的亂數；留空則自動產生並保存在 CLURE_DATA_PATH/api）
#   產生方式：openssl rand -base64 64
CLURE_JWT_SECRET=
# 首次啟動自動建立的管理員（三者都填才會建立；密碼需 8 字元以上且含英文與數字）
CLURE_ADMIN_USERNAME=
CLURE_ADMIN_EMAIL=
CLURE_ADMIN_PASSWORD=
# 是否開放註冊（只給家人使用時，可在建立帳號後改為 false）
CLURE_ALLOW_REGISTRATION=true
# 系統還沒有任何使用者時，第一位註冊者自動成為管理員（已用上面三個變數建立管理員時可設 false）
CLURE_FIRST_USER_ADMIN=true
# Cookie 的 Secure 屬性：auto＝經 HTTPS 時開啟（建議）；true／false 強制
CLURE_COOKIE_SECURE=auto
# 資料庫：留空使用 SQLite（存在 CLURE_DATA_PATH/api/clure.db）；PostgreSQL 範例：
#   CLURE_DATABASE_URL=postgresql+psycopg://clure:密碼@postgres:5432/clure
CLURE_DATABASE_URL=
POSTGRES_PASSWORD=change-me
CLURE_LOG_LEVEL=INFO
# 財政部電子發票應用 API（輸入手機條碼自動記帳）：需向財政部申請 AppID／APIKey。
#   自 112 年 3 月起只受理通過 ISO 27001 等資安認證的企業或組織，個人通常無法取得；留空時 App 會改用 QR Code 掃描與 CSV 匯入
CLURE_EINVOICE_APP_ID=
CLURE_EINVOICE_API_KEY=
# 報價代理 /proxy/ 是否只允許已登入的使用者（建置時關閉帳號系統 VITE_AUTH_MODE=off 才需要改成 false）
CLURE_PROXY_REQUIRE_LOGIN=true

# ── AI 功能（選用）──
# 管理員共用一把 Key，每位使用者有每日／每週／每月免費額度（Asia/Taipei 00:00 重置）。供應商依序嘗試，一家失敗、限流或逾時就換下一家。
# 沒填 Key 的供應商會自動略過；全部留空則 AI 功能顯示「尚未設定」。到「資安後台 → AI 主控台」可測試連線、看用量。
#
# 【推薦】Google Gemini（免費、不用信用卡）：到 https://aistudio.google.com/apikey 申請，只要填 Key 就能用
#   ⚠ 免費層有每分鐘／每日上限（以 AI Studio 的 Rate limit 頁面為準，會變動；每日額度在太平洋時間午夜重置），
#     且免費層的內容可能被 Google 用來改進產品。請把下面的全站上限設在你的實際額度以內。
# 背景推播的 VAPID 聯絡方式（mailto:你的信箱 或 https://你的網址）；空白用 mailto:admin@example.com
CLURE_VAPID_SUBJECT=

# — 資料庫自動備份（SQLite；每天一份，放在 data/api/backups）—
CLURE_BACKUP_DAILY=true
CLURE_BACKUP_KEEP=7
CLURE_BACKUP_HOUR=3

# — 寄信（忘記密碼）—
# 沒設定寄信時，忘記密碼頁會請使用者寄信給這個管理員信箱
CLURE_ADMIN_CONTACT_EMAIL=giter003@gmail.com
# 網站對外網址（信中的重設連結用），例如 https://aster.example.com
CLURE_PUBLIC_URL=
# 以 Gmail 為例：smtp.gmail.com／587／starttls，帳號是你的 Gmail，密碼要用「應用程式密碼」（Google 帳戶 → 安全性 → 兩步驟驗證 → 應用程式密碼）
CLURE_SMTP_HOST=
CLURE_SMTP_PORT=587
CLURE_SMTP_USER=
CLURE_SMTP_PASSWORD=
CLURE_SMTP_FROM=
CLURE_SMTP_SECURITY=starttls
# 註冊時檢查信箱網域真的存在且收信（擋掉打錯網域，例如 gmial.con）
CLURE_EMAIL_CHECK_DNS=true
CLURE_AI_PROVIDERS=nvidia,gemini,openrouter,custom
CLURE_AI_GEMINI_API_KEY=
CLURE_AI_GEMINI_MODEL=gemini-flash-lite-latest
# OpenRouter（https://openrouter.ai/keys；模型名稱結尾 :free 的有免費額度，但常限流、常下架）
CLURE_AI_OPENROUTER_API_KEY=
CLURE_AI_OPENROUTER_MODEL=google/gemma-4-31b-it:free
# NVIDIA NIM（https://build.nvidia.com，API Key 以 nvapi- 開頭）。預設模型 Nemotron 3.5 Super VL 是「推理模型」：
#   程式會自動帶 chat_template_kwargs.enable_thinking=false 關掉思考輸出（不然思考會用掉輸出長度、答案被截斷）。
#   免費模型常下架；若測試回 404／410，到網站挑一個目前可用的模型填入。
CLURE_AI_NVIDIA_API_KEY=
CLURE_AI_NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
# 自訂（任何 OpenAI 相容服務，例如 Groq、本機 Ollama）：三項都填才啟用。1.5.x 用 custom 接 Gemini 的舊設定仍然可用
CLURE_AI_CUSTOM_BASE_URL=
CLURE_AI_CUSTOM_API_KEY=
CLURE_AI_CUSTOM_MODEL=
# 進階：額外合併進請求的參數（JSON 物件），可用於關閉／調整推理模型的思考、覆寫 temperature 等。
#   留空＝使用內建預設（只有 nvidia 的 nemotron 模型會預設關閉思考）。例如 NVIDIA 官方建議的取樣：
#   CLURE_AI_NVIDIA_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false},"temperature":1.0,"top_p":0.95}
CLURE_AI_GEMINI_EXTRA_BODY=
CLURE_AI_OPENROUTER_EXTRA_BODY=
CLURE_AI_NVIDIA_EXTRA_BODY=
CLURE_AI_CUSTOM_EXTRA_BODY=
# 額度預設值（管理後台改過就以後台為準）：每位使用者的每日／每週／每月上限，全站每日上限與每分鐘上限（0＝不限）
#   收據辨識每次扣 2 點，其餘功能每次 1 點。全站上限用來保護免費額度，建議不要超過供應商的實際免費額度
CLURE_AI_USER_DAILY=30
CLURE_AI_USER_WEEKLY=120
CLURE_AI_USER_MONTHLY=400
CLURE_AI_GLOBAL_DAILY=100
# 管理員的額度與一般使用者分開計算（全站上限兩者合計）
CLURE_AI_ADMIN_DAILY=60
CLURE_AI_ADMIN_WEEKLY=300
CLURE_AI_ADMIN_MONTHLY=1000
CLURE_AI_GLOBAL_PER_MINUTE=8

# ── 報價代理 ──
# 存取權杖（選用）：NAS 版已要求登入才能使用 /proxy/；若把報價代理另外對外開放（例如直接開 9123 埠）請務必設定
PROXY_ACCESS_TOKEN=
