# 複製為 .env 後修改（docker compose 會自動讀取）

# ── 網站 ──
# 對外埠號（NAS 上的埠，容器內固定 9122）
CLURE_PORT=9122
TZ=Asia/Taipei

# ── 資料與權限（docker-compose.yml 熱更新版）──
# 資料庫等持久化資料放在哪裡（相對於專案資料夾，或填 NAS 上的絕對路徑，例如 /volume1/docker/clure-data）
#   ⚠ 覆蓋更新檔案時請保留這個資料夾；放在專案資料夾以外最安全
CLURE_DATA_PATH=./data
# 後端以哪個使用者身分寫入資料夾（Synology 一般為 1026／100；在 NAS 終端機執行 id 可查詢）
PUID=1026
PGID=100
# 前端建置器：檢查檔案變更的間隔、最後一次變更後等多久才建置（毫秒）、建置前是否先跑單元測試
CLURE_POLL_MS=2000
CLURE_SETTLE_MS=4000
CLURE_RUN_TESTS=false

# ── 後端帳號系統 ──
# JWT 簽章金鑰（建議設定一組 64 字元以上的亂數；留空則自動產生並保存在 CLURE_DATA_PATH/api）
#   產生方式：openssl rand -base64 64
CLURE_JWT_SECRET=
# 首次啟動自動建立的管理員（三者都填才會建立；密碼需 8 字元以上且含英文與數字）
CLURE_ADMIN_USERNAME=
CLURE_ADMIN_EMAIL=
CLURE_ADMIN_PASSWORD=
# 是否開放註冊（只給家人使用時，可在建立帳號後改為 false）
CLURE_ALLOW_REGISTRATION=true
# 系統還沒有任何使用者時，第一位註冊者自動成為管理員（已用上面三個變數建立管理員時可設 false）
CLURE_FIRST_USER_ADMIN=true
# Cookie 的 Secure 屬性：auto＝經 HTTPS 時開啟（建議）；true／false 強制
CLURE_COOKIE_SECURE=auto
# 資料庫：留空使用 SQLite（存在 CLURE_DATA_PATH/api/clure.db）；PostgreSQL 範例：
#   CLURE_DATABASE_URL=postgresql+psycopg://clure:密碼@postgres:5432/clure
CLURE_DATABASE_URL=
POSTGRES_PASSWORD=change-me
CLURE_LOG_LEVEL=INFO
# 報價代理 /proxy/ 是否只允許已登入的使用者（建置時關閉帳號系統 VITE_AUTH_MODE=off 才需要改成 false）
CLURE_PROXY_REQUIRE_LOGIN=true

# ── 報價代理 ──
# 存取權杖（選用）：NAS 版已要求登入才能使用 /proxy/；若把報價代理另外對外開放（例如直接開 9123 埠）請務必設定
PROXY_ACCESS_TOKEN=
