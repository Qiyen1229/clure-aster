# syntax=docker/dockerfile:1
# Aster 報價代理（Node 22 內建 fetch 與 TypeScript strip-types，無任何 npm 相依）
FROM node:22-alpine
WORKDIR /app
COPY proxy/src ./src
COPY proxy/node-server.ts ./node-server.ts
ENV PORT=9123 NODE_ENV=production
EXPOSE 9123
USER node
HEALTHCHECK --interval=30s --timeout=3s --retries=3 CMD wget -qO- http://127.0.0.1:9123/proxy/health || exit 1
CMD ["node", "--experimental-strip-types", "--no-warnings", "node-server.ts"]
