{
  "name": "aster",
  "private": true,
  "version": "3.6.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 9122 --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 9122 --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/gen-icons.mjs",
    "pack:nas": "sh scripts/pack-nas.sh",
    "deploy:nas": "sh scripts/deploy-nas.sh",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\"",
    "format:write": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\"",
    "check": "tsc --noEmit && eslint . && vitest run"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.14",
    "browser-image-compression": "^2.0.2",
    "date-fns": "^3.6.0",
    "decimal.js": "^10.6.0",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^1.1.7",
    "echarts": "^5.6.0",
    "fflate": "^0.8.3",
    "i18next": "^23.16.8",
    "jsqr": "^1.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.7.4",
    "react-router-dom": "^6.30.6",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.13.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.9.10",
    "sharp": "^0.33.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^5.4.21",
    "vite-plugin-pwa": "^0.20.5",
    "vitest": "^2.1.9",
    "workbox-core": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  }
}
